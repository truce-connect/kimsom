{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://node-express-app-03440dfc.containers.snapdeploy.app/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
