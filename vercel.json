{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://kimsonbackend-j2kc744nb-truces-projects.vercel.app/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
